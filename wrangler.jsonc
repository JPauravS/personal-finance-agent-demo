{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "personal-finance-advisor",
	"main": "worker_main.py",
	"compatibility_date": "2025-11-02",
	"compatibility_flags": [
		"python_workers",
		"python_dedicated_snapshot"
	],
	"assets": {
		"directory": "./worker-assets/",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	}
}
